# Copy to .env and source it, or export these directly.
S2S_MYSQL_DSN=s2s:s2spw@tcp(127.0.0.1:3308)/s2s?parseTime=true&multiStatements=true&loc=UTC
S2S_REDIS_ADDR=127.0.0.1:6381
S2S_REDIS_ENABLED=true
S2S_SERVER_ADMIN_API_KEY=dev-admin-key-change-me
S2S_LOG_LEVEL=info
S2S_LOG_FORMAT=text
# Sampling applies to info/debug only; warn and above are never sampled.
# S2S_LOG_SAMPLE_INITIAL=100
# S2S_LOG_SAMPLE_THEREAFTER=100
